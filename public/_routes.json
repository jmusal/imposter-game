{
  "version": 1,
  "include": ["/*"],
  "exclude": [
    "/assets/*",
    "/favicon.svg",
    "/icons.svg",
    "/manifest.webmanifest",
    "/robots.txt",
    "/sw.js",
    "/registerSW.js"
  ],
  "rules": [
    {
      "type": "rewrite",
      "regex": "^(?!.*\\.(js|css|svg|png|ico|webp|gif|woff|woff2|eot|ttf|otf|json|txt|xml|map)).*$",
      "target": "/index.html"
    }
  ]
}
